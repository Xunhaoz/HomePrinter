# Copy to .env and fill in. docker compose reads .env from this folder.

# Login code for the web app: about six letters, case-insensitive. Required.
ACCESS_CODE=

# How long a login lasts, in days.
SESSION_DAYS=30

# The printer's IP on your LAN (reserve it in the router's DHCP settings).
PRINTER_HOST=192.168.0.126

# Port the web app (and /api) is served on.
WEB_PORT=8088
